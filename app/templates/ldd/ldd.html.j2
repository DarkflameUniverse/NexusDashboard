    };
    // start request
    xhr.send();
    return dburl
  }


  class DBURLFile {
    constructor(urlHandle, name) {
      this.urlHandle = urlHandle
      this.name = name
    }

    // Fetch the file asynchronously (once) and keep it for read().
    load() {
      if (!this.loading) {
        this.loading = fetch(this.urlHandle).then(function (response) {
          if (!response.ok) throw new Error('HTTP ' + response.status + ' for ' + response.url)
          return response.arrayBuffer()
        }).then((buffer) => {
          this.content = bytesToUserDefinedString(buffer)
        }).catch((error) => {
          console.log('Error loading', this.urlHandle, error)
          this.content = ''
        })
      }
      return this.loading
    }

    read() {
      // Prefetched by load(): no request needed
      if (this.content !== undefined) return this.content
      let fileContent
      let self = this;
      let xhr = new XMLHttpRequest();
      xhr.open('GET', self.urlHandle, false);
      // Hack to pass bytes through unprocessed.
      xhr.overrideMimeType('text/plain; charset=x-user-defined');

      // request state change event
      xhr.onreadystatechange = function() {

        // request completed?
        if (xhr.readyState !== 4) {//return;
          console.log('readyState error in DBURLFile:', xhr.status, xhr.statusText);
        }
        if (xhr.status === 200) {
          // request successful - show response
          fileContent = xhr.responseText;
        }
        else {
          // request error
          console.log('HTTP error in DBURLFile:', xhr.status, xhr.statusText);
        }
      };

      // start request
      xhr.send();
      return fileContent
    }
  }


  // Same string the synchronous XHR with the 'x-user-defined' charset hack
  // produced: ASCII bytes as-is, bytes >= 0x80 mapped to U+F780..U+F7FF.
  function bytesToUserDefinedString(buffer) {
    const bytes = new Uint8Array(buffer)
    const chunk = 8192
    let out = ''
    for (let i = 0; i < bytes.length; i += chunk) {
      const part = bytes.subarray(i, i + chunk)
      const codes = new Array(part.length)
      for (let j = 0; j < part.length; j++) {
        const b = part[j]
        codes[j] = b < 0x80 ? b : 0xF700 + b
      }
      out += String.fromCharCode.apply(null, codes)
    }
    return out
  }

  // Run fn over items with at most `limit` in flight at a time.
  async function runLimited(items, limit, fn) {
    let next = 0
    async function worker() {
      while (next < items.length) {
        const item = items[next++]
        await fn(item)
      }
    }
    const workers = []
    for (let i = 0; i < Math.min(limit, items.length); i++) workers.push(worker())
    await Promise.all(workers)
  }

  const FETCH_CONCURRENCY = 8

  // Asynchronous version of DBURLReader: lists the brick database and
  // prefetches info.xml / Materials.xml without blocking the main thread.
  async function loadDBURLReader(dburl) {
    const reader = Object.create(DBURLReader.prototype)
    reader.filelist = {}
    reader.initok = false
    reader.location = dburl
    reader.dbinfo = ''
    async function parse(url) {
      const response = await fetch(url)
      if (!response.ok) {
        console.log('HTTP error', response.status, response.statusText)
        return
      }
      const data = await response.json()
      const subdirs = []
      for (const obj of data) {
        if (obj.type == 'directory') subdirs.push(url + obj.name + '/')
        else if (obj.type == 'file') reader.filelist[obj.name] = new DBURLFile(url + obj.name, obj.name)
        else console.log('Strange object parsed: ' + obj.type)
      }
      await Promise.all(subdirs.map(parse))
    }
    await parse(dburl)
    if (reader.fileexist('Materials.xml') && reader.fileexist('info.xml')) {
      await Promise.all([reader.filelist['Materials.xml'].load(), reader.filelist['info.xml'].load()])
      reader.dbinfo = new DBinfo(reader.filelist['info.xml'].read())
      reader.initok = true
    }
    return reader
  }

  class DBURLReader {
    constructor(dburl) {
      this.filelist = {};
      this.initok = false;
      this.location = dburl;
      this.dbinfo = '';
      this.parse(this.location);

      // console.log(JSON.stringify(this.filelist))

      if(this.fileexist('Materials.xml') && this.fileexist('info.xml')){
        this.dbinfo = new DBinfo(this.filelist['info.xml'].read());
        this.initok = true
      }
      else{
        alert("db url ERROR")
      }
    }

    fileexist(filename) {
      let self = this;
      return self.filelist[filename];
    }

    parse(dburl, folder="") {
      let self = this;
      let xhr = new XMLHttpRequest();
      xhr.open('GET', dburl, false);

      // request state change event
      xhr.onreadystatechange = function() {

        // request completed?
        if (xhr.readyState !== 4) return;

        if (xhr.status === 200) {
          // request successful - show response
          let data = JSON.parse(xhr.responseText)
          //console.log(JSON.stringify(data, null, "\t"));
          for(let i = 0; i < data.length; i++) {
            let obj = data[i];
            if (obj.type == 'directory'){
              // parse subdirs
              self.parse(dburl + obj.name + '/', obj.name)
            }
            else if (obj.type == 'file'){
              self.filelist[obj.name] = new DBURLFile(dburl + obj.name, obj.name)
            }
            else {
              console.log('Strange object parsed: ' + obj.type)
            }
          }
        }
        else {
          // request error
          console.log('HTTP error', xhr.status, xhr.statusText);
        }
      };
      // start request
      xhr.send();
    }
  }


  //Start
  let lxfml_file_list = [
    {% for model in content %}
      {% if model.lot == 14 %}
        {
          "id": {{ model.id|string|tojson }},
          "url": "{{url_for('properties.get_model', id=model.id, file_format='lxfml', lod=lod)}}",
          "pos": {{ model.pos|tojson }}
        },
      {% endif %}
