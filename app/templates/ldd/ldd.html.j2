  ]
  // All UGC LXFML of a property in one request (view_models); otherwise per model
  const ugcBatchUrl = {{ ugc_batch_url|default(none)|tojson }}

  // Load the brick-built (UGC) models without blocking the page: fetch the
  // LXFML (batched), then each needed brick primitive once with bounded
  // concurrency, then build the meshes in small slices so the progress badge
  // keeps updating.
  async function loadUGCModels() {
    if (lxfml_file_list.length === 0) return
    let built = 0
    try {
      setProgressDetail('brick database')
      const database = await loadDBURLReader('/luclient/ldddb/')
      if (!database.initok) {
        alert("LDD database not available. Please look for LEGO-Digital-Designer database.")
        throw new Error('LDD database not available')
      }
      const converter = new Converter()
      converter.database = database
      converter.allMaterials = new Materials(database.filelist['Materials.xml'].read())

      setProgressDetail('model files')
      let texts
      if (ugcBatchUrl) {
        const response = await fetch(ugcBatchUrl)
        if (!response.ok) throw new Error('HTTP ' + response.status + ' for ' + ugcBatchUrl)
        const data = await response.json()
        texts = lxfml_file_list.map(function (m) { return data[m.id] })
      } else {
        texts = new Array(lxfml_file_list.length)
        await runLimited(lxfml_file_list.map(function (m, i) { return i }), FETCH_CONCURRENCY, async function (i) {
          try {
            const response = await fetch(lxfml_file_list[i].url)
            if (response.ok) texts[i] = bytesToUserDefinedString(await response.arrayBuffer())
          } catch (error) { console.log(error) }
        })
      }

      let lastYield = performance.now()
      async function maybeYield() {
        if (performance.now() - lastYield > 30) {
          await new Promise(function (resolve) { setTimeout(resolve) })
          lastYield = performance.now()
        }
      }

      // parse the scenes and collect the bricks they use
      const scenes = []
      for (let i = 0; i < texts.length; i++) {
        let parsed = null
        if (texts[i]) {
          try { parsed = new Scene(); parsed.AddSceneData(texts[i]) } catch (error) { console.log(error); parsed = null }
        }
        scenes.push(parsed)
        await maybeYield()
      }
      const files = new Set()
      const lod = {{ lod }}
      for (const parsed of scenes) {
        if (!parsed) continue
        for (const brick of parsed.Bricks) {
          for (const part of brick.Parts) {
            let n = 0
            let location = `brickprimitives/lod${lod}/${part.designID}.g`
            while (location in database.filelist) {
              files.add(database.filelist[location])
              n += 1
              location = `brickprimitives/lod${lod}/${part.designID}.g${n}`
            }
            const primitive = database.filelist[`Primitives/${part.designID}.xml`]
            if (primitive) files.add(primitive)
          }
        }
      }
      // each primitive is fetched once (Set + DBURLFile.load() caching)
      const fileList = Array.from(files)
      let fetched = 0
      setProgressDetail('bricks 0/' + fileList.length)
      await runLimited(fileList, FETCH_CONCURRENCY, async function (file) {
        await file.load()
        fetched += 1
        setProgressDetail('bricks ' + fetched + '/' + fileList.length)
      })
      setProgressDetail('')

      // build the meshes
      for (let i = 0; i < scenes.length; i++) {
        built += 1
        if (!scenes[i]) { modelDone(true); continue }
        try {
          converter.scene = scenes[i]
          converter.Export('test.webgl', lxfml_file_list[i].pos)
          modelDone(false)
        } catch (error) {
          console.log(error)
          modelDone(true)
        }
        if (performance.now() - lastYield > 30) {
          loadProgressRender()
          await maybeYield()
        }
      }
    } catch (error) {
      console.log(error)
      // whatever was not built counts as failed
      for (; built < lxfml_file_list.length; built++) modelDone(true)
    }
    setProgressDetail('')
    {% if not center and not content|length > 1 %}
      // the camera follows the brick-built model, now that its position is known
      camera.position.set( brick_pos.x + 200, brick_pos.y + 300, brick_pos.z + 200 );
      controls.update()
    {% endif %}
  }

  const onProgress = function ( xhr ) {

    if ( xhr.lengthComputable ) {

      const percentComplete = xhr.loaded / xhr.total * 100;
      console.log( Math.round( percentComplete, 2 ) + '% downloaded' );

    }

  };

  const onError = function (error) {
    console.log(error)
    loadProgressRender()
   };

  // Render on demand: only draw when something changed (a load finished,
  // the camera moved or the window resized), at most once per animation frame.
  let renderPending = false
  function requestRender() {
    if (renderPending) return
    renderPending = true
    requestAnimationFrame(function () {
      renderPending = false
      renderer.render(scene, camera)
    })
  }

  // Redraw behaviour while models are still loading (PROPERTY_VIEWER_LOAD_REDRAW):
  //   'none'     - do not redraw for finished loads; draw once when everything is done
  //   'interval' - redraw at most every PROPERTY_VIEWER_REDRAW_INTERVAL_MS while loading
  // Camera moves and resizes always redraw. The final draw also happens when loads fail.
  const loadRedraw = {{ load_redraw|default('none')|tojson }}
  const redrawIntervalMs = {{ redraw_interval_ms|default(500)|int }}
  let modelsLoading = true
  let lastLoadRender = 0
  let loadRenderTimer = null
  // Progress indicator (a DOM element, so updating it never redraws the canvas).
  // Counts models: brick-built (lxfml) models count once their meshes are built,
  // pre-built models when their OBJ loads or their MTL/OBJ fails.
  const loadingIndicator = document.createElement('div')
  loadingIndicator.id = 'loading-progress'
  loadingIndicator.style.cssText = 'position:fixed;top:8px;left:8px;padding:4px 8px;background:rgba(20,20,20,0.93);color:#fff;font:bold 14px sans-serif;border:1px solid rgba(255,255,255,0.35);border-radius:4px;text-shadow:0 1px 2px rgba(0,0,0,0.8);box-shadow:0 1px 4px rgba(0,0,0,0.5);z-index:10;pointer-events:none;transition:opacity 1s'
  document.body.appendChild(loadingIndicator)
  const spinnerStyle = document.createElement('style')
  spinnerStyle.textContent = '@keyframes loading-spin{to{transform:rotate(360deg)}}#loading-progress .loading-spinner{display:inline-block;width:11px;height:11px;margin-right:7px;vertical-align:-1px;border:2px solid rgba(255,255,255,0.3);border-top-color:#fff;border-radius:50%;animation:loading-spin 0.8s linear infinite;will-change:transform}'
  document.head.appendChild(spinnerStyle)
  let finalRendering = false
  let modelsTotal = 0, modelsDone = 0, modelsFailed = 0
  let progressPending = false
  let progressDetail = ''
  let prebuiltDetail = ''
  function progressText() {
    let pct = modelsTotal ? Math.floor(modelsDone / modelsTotal * 100) : 100
    let failed = modelsFailed ? ' (' + modelsFailed + ' failed)' : ''
    let parts = [prebuiltDetail, progressDetail].filter(Boolean).join(', ')
    let detail = (modelsLoading && parts) ? ' \u2013 ' + parts : ''
    return (modelsLoading ? 'Loading models: ' : 'Loaded ') + pct + '% (' + modelsDone + '/' + modelsTotal + ')' + failed + detail
  }
  function setProgressDetail(text) {
    progressDetail = text
    updateProgress()
  }
  function updateProgress() {
    // Batch DOM updates to one per animation frame
    if (progressPending) return
    progressPending = true
    requestAnimationFrame(function () { progressPending = false; if (!finalRendering) loadingIndicator.textContent = progressText() })
  }
  function modelDone(failed) {
    modelsDone++
    if (failed) modelsFailed++
    updateProgress()
  }

  function loadProgressRender() {
    if (!modelsLoading) return requestRender()
    if (loadRedraw !== 'interval' || loadRenderTimer) return
    let wait = Math.max(0, lastLoadRender + redrawIntervalMs - performance.now())
    loadRenderTimer = setTimeout(function () {
      loadRenderTimer = null
      lastLoadRender = performance.now()
      requestRender()
    }, wait)
  }

  // Done once both the loading manager (pre-built models, ground texture) and
  // the brick-built models have finished.
  let managerDone = false
  let ugcDone = lxfml_file_list.length === 0
  function partFinished() {
    if (managerDone && ugcDone && modelsLoading) loadsFinished()
  }

  function loadsFinished() {
    modelsLoading = false
    if (loadRenderTimer) { clearTimeout(loadRenderTimer); loadRenderTimer = null }
    // The final full render can block the main thread for a while on large
    // properties. Show a 'Rendering' state with a CSS spinner (a transform
    // animation, which the compositor keeps running while the main thread is
    // busy), let it paint, then render and show the result.
    let parts = 0
    scene.traverse(function (o) { if (o.isMesh) parts++ })
    finalRendering = true
    loadingIndicator.textContent = ''
    const spinner = document.createElement('span')
    spinner.className = 'loading-spinner'
    loadingIndicator.appendChild(spinner)
    loadingIndicator.appendChild(document.createTextNode(parts ? 'Rendering ' + parts + ' parts\u2026' : 'Rendering\u2026'))
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        renderer.render(scene, camera)
        finalRendering = false
        loadingIndicator.textContent = progressText()
        loadingIndicator.style.background = modelsFailed ? 'rgba(170,70,0,0.94)' : 'rgba(0,105,40,0.94)'
        // Keep the completion state visible briefly, then fade to a faint badge
        setTimeout(function () { loadingIndicator.style.opacity = '0.7' }, 3000)
      })
    })
  }

  // Shared by the model/texture loaders; onLoad fires once all queued items
  // (successful or failed) have finished.
  let loadsStarted = false
  const loadingManager = new THREE.LoadingManager(function () { managerDone = true; partFinished() }, loadProgressRender, loadProgressRender)
  loadingManager.onStart = function () { loadsStarted = true; managerDone = false; loadingIndicator.style.opacity = '1' }

  // Load in pre-built models
  let obj_file_list = [
    {% for model in content %}
      {% if model.lot != 14 %}
        {{ model }} {{ ", " if not loop.last else "" }}
      {% endif %}
    {% endfor %}
  ]

  modelsTotal = obj_file_list.length + lxfml_file_list.length
  modelsDone = 0
  loadingIndicator.textContent = progressText()

  // Pre-built stage on the badge: materials arrive before any OBJ can load
  let materialsLoaded = 0
  function materialLoaded() {
    materialsLoaded++
    prebuiltDetail = materialsLoaded < obj_file_list.length ? 'materials ' + materialsLoaded + '/' + obj_file_list.length : ''
    updateProgress()
  }
  if (obj_file_list.length) { prebuiltDetail = 'materials 0/' + obj_file_list.length; updateProgress() }

  for (let i = 0; i < obj_file_list.length; i++) {
    let mtlLoader = new MTLLoader(loadingManager);
    mtlLoader.load( obj_file_list[i].mtl, function( materials ) {
        materialLoaded()
        materials.preload();
        let objLoader = new OBJLoader(loadingManager);
        objLoader.setMaterials( materials );

        objLoader.load( obj_file_list[i].obj, function ( object ) {
          // console.log(obj_file_list[i].pos)
          for (let j = 0; j < obj_file_list[i].pos.length; j++) {
            // console.log(obj_file_list[i].pos[j])
            var newModel = object.clone();
            newModel.position.x = obj_file_list[i].pos[j].x;
            newModel.position.y = obj_file_list[i].pos[j].y;
            newModel.position.z = obj_file_list[i].pos[j].z;

            let quaternion = new THREE.Quaternion(
              obj_file_list[i].pos[j].rx,
              obj_file_list[i].pos[j].ry,
              obj_file_list[i].pos[j].rz,
              obj_file_list[i].pos[j].rw
            );
            newModel.rotation.setFromQuaternion(quaternion)

            scene.add( newModel );
          };
          modelDone(false)
          loadProgressRender()
        }, onProgress, function (error) { modelDone(true); onError(error) } );
    }, undefined, function (error) { materialLoaded(); modelDone(true); onError(error) });
  }

  // Three.JS stuff
  let container = document.createElement( 'div' );
  document.body.appendChild( container );

  let camera = new THREE.PerspectiveCamera( 2.5, window.innerWidth / window.innerHeight, 1, 10000 );
  {% if center %}
    camera.position.set( brick_pos.x + 800, brick_pos.y + 800, brick_pos.z + 800 );
  {% elif content|length > 1 %}
    camera.position.set( {{ content[0].x }}+ 200, {{ content[0].y }}+ 300, {{ content[0].z }}+ 200 );
  {% else %}
    camera.position.set( brick_pos.x + 200, brick_pos.y + 300, brick_pos.z + 200 );
  {% endif %}

  {% if center %}
    let center = new THREE.Vector3{{ center }};
    let groundTexture = new THREE.TextureLoader(loadingManager).load( "{{url_for('luclient.get_dds_as_png', filename='env_nim_ag_grass.dds')}}");
    groundTexture.wrapS = groundTexture.wrapT = THREE.RepeatWrapping;
    groundTexture.repeat.set( 10, 10 );
    groundTexture.anisotropy = 16;
    groundTexture.encoding = THREE.sRGBEncoding;
    let groundMaterial = new THREE.MeshStandardMaterial( { map: groundTexture } );
    let mesh = new THREE.Mesh( new THREE.PlaneBufferGeometry( 400, 400 ), groundMaterial );
    mesh.position.y = center.y;
    mesh.position.x = center.x;
    mesh.position.z = center.z
    mesh.rotation.x = - Math.PI / 2;
    mesh.receiveShadow = true;
    scene.add( mesh );
  {% endif %}

  // scene
  scene.background = new THREE.Color( 0xdeebed );

  let ambientLight = new THREE.AmbientLight( 0xdeebed, 0.4 );
  scene.add( ambientLight );

  let directionalLight = new THREE.DirectionalLight( 0xffffff, 0.75 );
  directionalLight.position.set( - 10000, 12000, 15000 );
  scene.add( directionalLight );

  let directionalLight2 = new THREE.DirectionalLight( 0xffffff, 0.75 );
  directionalLight2.position.set( 10000, 12000, -15000 );
  scene.add( directionalLight2 );

  let renderer = new THREE.WebGLRenderer( { antialias: true, alpha: true } );
  renderer.setPixelRatio( window.devicePixelRatio );
  renderer.setSize( window.innerWidth, window.innerHeight );
  container.appendChild( renderer.domElement );

  let controls = new THREE.OrbitControls (camera, renderer.domElement);
  {% if content|length == 1 and content[0].lot != 14 %}
    controls.target = new THREE.Vector3({{ content[0].pos[0].x }}, {{ content[0].pos[0].y }}, {{ content[0].pos[0].z }})
  {% else %}
    controls.target = brick_pos
  {% endif %}
  controls.update()
  // if ( vnh ) vnh.update();

  controls.addEventListener('change', requestRender)

  window.addEventListener('resize', function () {
    camera.aspect = window.innerWidth / window.innerHeight
    camera.updateProjectionMatrix()
    renderer.setSize(window.innerWidth, window.innerHeight)
    requestRender()
  })

  // Nothing queued on the loading manager (e.g. only brick-built models)
  if (!loadsStarted) managerDone = true
  loadUGCModels().then(function () { ugcDone = true; partFinished() })
  partFinished()
  requestRender();
</script>

</body>
</html>
